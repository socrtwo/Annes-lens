<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with Anne's Lens" for every picture type (a mimeType-only <data> matches content: and file: URIs). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Files whose provider reports a generic MIME type: match on extension. Several pathPatterns per
                 extension because Android's matcher is non-greedy and stops at the first dot. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.jpg" />
                <data android:pathPattern=".*\\..*\\.jpg" />
                <data android:pathPattern=".*\\..*\\..*\\.jpg" />
                <data android:pathPattern=".*\\.JPG" />
                <data android:pathPattern=".*\\..*\\.JPG" />
                <data android:pathPattern=".*\\..*\\..*\\.JPG" />
                <data android:pathPattern=".*\\.jpeg" />
                <data android:pathPattern=".*\\..*\\.jpeg" />
                <data android:pathPattern=".*\\..*\\..*\\.jpeg" />
                <data android:pathPattern=".*\\.JPEG" />
                <data android:pathPattern=".*\\..*\\.JPEG" />
                <data android:pathPattern=".*\\..*\\..*\\.JPEG" />
                <data android:pathPattern=".*\\.jpe" />
                <data android:pathPattern=".*\\..*\\.jpe" />
                <data android:pathPattern=".*\\..*\\..*\\.jpe" />
                <data android:pathPattern=".*\\.JPE" />
                <data android:pathPattern=".*\\..*\\.JPE" />
                <data android:pathPattern=".*\\..*\\..*\\.JPE" />
                <data android:pathPattern=".*\\.jfif" />
                <data android:pathPattern=".*\\..*\\.jfif" />
                <data android:pathPattern=".*\\..*\\..*\\.jfif" />
                <data android:pathPattern=".*\\.JFIF" />
                <data android:pathPattern=".*\\..*\\.JFIF" />
                <data android:pathPattern=".*\\..*\\..*\\.JFIF" />
                <data android:pathPattern=".*\\.png" />
                <data android:pathPattern=".*\\..*\\.png" />
                <data android:pathPattern=".*\\..*\\..*\\.png" />
                <data android:pathPattern=".*\\.PNG" />
                <data android:pathPattern=".*\\..*\\.PNG" />
                <data android:pathPattern=".*\\..*\\..*\\.PNG" />
                <data android:pathPattern=".*\\.apng" />
                <data android:pathPattern=".*\\..*\\.apng" />
                <data android:pathPattern=".*\\..*\\..*\\.apng" />
                <data android:pathPattern=".*\\.APNG" />
                <data android:pathPattern=".*\\..*\\.APNG" />
                <data android:pathPattern=".*\\..*\\..*\\.APNG" />
                <data android:pathPattern=".*\\.gif" />
                <data android:pathPattern=".*\\..*\\.gif" />
                <data android:pathPattern=".*\\..*\\..*\\.gif" />
                <data android:pathPattern=".*\\.GIF" />
                <data android:pathPattern=".*\\..*\\.GIF" />
                <data android:pathPattern=".*\\..*\\..*\\.GIF" />
                <data android:pathPattern=".*\\.webp" />
                <data android:pathPattern=".*\\..*\\.webp" />
                <data android:pathPattern=".*\\..*\\..*\\.webp" />
                <data android:pathPattern=".*\\.WEBP" />
                <data android:pathPattern=".*\\..*\\.WEBP" />
                <data android:pathPattern=".*\\..*\\..*\\.WEBP" />
                <data android:pathPattern=".*\\.avif" />
                <data android:pathPattern=".*\\..*\\.avif" />
                <data android:pathPattern=".*\\..*\\..*\\.avif" />
                <data android:pathPattern=".*\\.AVIF" />
                <data android:pathPattern=".*\\..*\\.AVIF" />
                <data android:pathPattern=".*\\..*\\..*\\.AVIF" />
                <data android:pathPattern=".*\\.heic" />
                <data android:pathPattern=".*\\..*\\.heic" />
                <data android:pathPattern=".*\\..*\\..*\\.heic" />
                <data android:pathPattern=".*\\.HEIC" />
                <data android:pathPattern=".*\\..*\\.HEIC" />
                <data android:pathPattern=".*\\..*\\..*\\.HEIC" />
                <data android:pathPattern=".*\\.heif" />
                <data android:pathPattern=".*\\..*\\.heif" />
                <data android:pathPattern=".*\\..*\\..*\\.heif" />
                <data android:pathPattern=".*\\.HEIF" />
                <data android:pathPattern=".*\\..*\\.HEIF" />
                <data android:pathPattern=".*\\..*\\..*\\.HEIF" />
                <data android:pathPattern=".*\\.bmp" />
                <data android:pathPattern=".*\\..*\\.bmp" />
                <data android:pathPattern=".*\\..*\\..*\\.bmp" />
                <data android:pathPattern=".*\\.BMP" />
                <data android:pathPattern=".*\\..*\\.BMP" />
                <data android:pathPattern=".*\\..*\\..*\\.BMP" />
                <data android:pathPattern=".*\\.dib" />
                <data android:pathPattern=".*\\..*\\.dib" />
                <data android:pathPattern=".*\\..*\\..*\\.dib" />
                <data android:pathPattern=".*\\.DIB" />
                <data android:pathPattern=".*\\..*\\.DIB" />
                <data android:pathPattern=".*\\..*\\..*\\.DIB" />
                <data android:pathPattern=".*\\.ico" />
                <data android:pathPattern=".*\\..*\\.ico" />
                <data android:pathPattern=".*\\..*\\..*\\.ico" />
                <data android:pathPattern=".*\\.ICO" />
                <data android:pathPattern=".*\\..*\\.ICO" />
                <data android:pathPattern=".*\\..*\\..*\\.ICO" />
                <data android:pathPattern=".*\\.cur" />
                <data android:pathPattern=".*\\..*\\.cur" />
                <data android:pathPattern=".*\\..*\\..*\\.cur" />
                <data android:pathPattern=".*\\.CUR" />
                <data android:pathPattern=".*\\..*\\.CUR" />
                <data android:pathPattern=".*\\..*\\..*\\.CUR" />
                <data android:pathPattern=".*\\.tif" />
                <data android:pathPattern=".*\\..*\\.tif" />
                <data android:pathPattern=".*\\..*\\..*\\.tif" />
                <data android:pathPattern=".*\\.TIF" />
                <data android:pathPattern=".*\\..*\\.TIF" />
                <data android:pathPattern=".*\\..*\\..*\\.TIF" />
                <data android:pathPattern=".*\\.tiff" />
                <data android:pathPattern=".*\\..*\\.tiff" />
                <data android:pathPattern=".*\\..*\\..*\\.tiff" />
                <data android:pathPattern=".*\\.TIFF" />
                <data android:pathPattern=".*\\..*\\.TIFF" />
                <data android:pathPattern=".*\\..*\\..*\\.TIFF" />
                <data android:pathPattern=".*\\.svg" />
                <data android:pathPattern=".*\\..*\\.svg" />
                <data android:pathPattern=".*\\..*\\..*\\.svg" />
                <data android:pathPattern=".*\\.SVG" />
                <data android:pathPattern=".*\\..*\\.SVG" />
                <data android:pathPattern=".*\\..*\\..*\\.SVG" />
                <data android:pathPattern=".*\\.psd" />
                <data android:pathPattern=".*\\..*\\.psd" />
                <data android:pathPattern=".*\\..*\\..*\\.psd" />
                <data android:pathPattern=".*\\.PSD" />
                <data android:pathPattern=".*\\..*\\.PSD" />
                <data android:pathPattern=".*\\..*\\..*\\.PSD" />
                <data android:pathPattern=".*\\.tga" />
                <data android:pathPattern=".*\\..*\\.tga" />
                <data android:pathPattern=".*\\..*\\..*\\.tga" />
                <data android:pathPattern=".*\\.TGA" />
                <data android:pathPattern=".*\\..*\\.TGA" />
                <data android:pathPattern=".*\\..*\\..*\\.TGA" />
                <data android:pathPattern=".*\\.jxl" />
                <data android:pathPattern=".*\\..*\\.jxl" />
                <data android:pathPattern=".*\\..*\\..*\\.jxl" />
                <data android:pathPattern=".*\\.JXL" />
                <data android:pathPattern=".*\\..*\\.JXL" />
                <data android:pathPattern=".*\\..*\\..*\\.JXL" />
                <data android:pathPattern=".*\\.cbz" />
                <data android:pathPattern=".*\\..*\\.cbz" />
                <data android:pathPattern=".*\\..*\\..*\\.cbz" />
                <data android:pathPattern=".*\\.CBZ" />
                <data android:pathPattern=".*\\..*\\.CBZ" />
                <data android:pathPattern=".*\\..*\\..*\\.CBZ" />
            </intent-filter>

            <!-- Receive pictures shared from other apps (one or several). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- The Anne's Office apps this one can hand documents to (Android 11+ package visibility). -->
    <queries>
        <package android:name="io.github.socrtwo.quillpen" />
        <package android:name="io.github.socrtwo.quillpost" />
        <package android:name="io.github.socrtwo.quillgrid" />
        <package android:name="io.github.socrtwo.quillstage" />
        <package android:name="io.github.socrtwo.quillloom" />
        <package android:name="io.github.socrtwo.quillpress" />
        <package android:name="io.github.socrtwo.quillfolio" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
